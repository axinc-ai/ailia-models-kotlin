<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- コンテンツ全体を縦スクロール可能にする(Landscape対応)。
         Processing Timeは常に画面最下部に固定する。 -->
    <ScrollView
        android:id="@+id/rootScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- アルゴリズム選択: 全体メニュー風のバー(背景色付き・画面幅いっぱい)。
         ドロップダウンは画面中央のダイアログ表示にする -->
    <Spinner
        android:id="@+id/algorithmSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/menu_bar_bg"
        android:spinnerMode="dialog"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- モデル選択(モデル名表示を兼ねる)。S2T/TTS/LLMのモデルや
         YOLOX等のTFLite/ONNX選択もここに統合する -->
    <Spinner
        android:id="@+id/modelSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/algorithmSpinner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RadioGroup
        android:id="@+id/modeRadioGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/modelSpinner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/imageRadioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Image Mode"
            android:checked="true" />

        <RadioButton
            android:id="@+id/cameraRadioButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Camera Mode"
            android:layout_marginStart="16dp" />

    </RadioGroup>

    <Spinner
        android:id="@+id/cameraSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/modeRadioGroup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <!-- 画像系アルゴリズム用のRunボタン(押して初めてダウンロード+実行)。
         バックエンド選択(Environment)はRunボタンの右側に同じ高さで配置する -->
    <Button
        android:id="@+id/visionRunButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:text="Run"
        app:layout_constraintTop_toBottomOf="@+id/cameraSpinner"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/envSpinner"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toTopOf="@+id/visionRunButton"
        app:layout_constraintStart_toEndOf="@+id/visionRunButton"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone" />

    <!-- Run/バックエンド行の下端(GONEも考慮)にコンテンツを配置するためのバリア -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/controlsBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="visionRunButton,envSpinner" />

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/controlsBottomBarrier" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="#00FFFFFF"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/controlsBottomBarrier" />

    <ScrollView
        android:id="@+id/resultScrollView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="?android:attr/colorBackground"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/controlsBottomBarrier">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RadioGroup
                android:id="@+id/speechModeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/wavRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wav"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/micRadioButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mic"
                    android:layout_marginStart="16dp" />

            </RadioGroup>

            <!-- 言語選択はMicモード時のみ表示(Wavモードはauto固定) -->
            <TextView
                android:id="@+id/speechLanguageLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Language:"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/speechLanguageSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/diarizationCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Speaker Diarization (pyannote-audio)"
                android:textColor="?android:attr/textColorPrimary"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/liveModeCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Live Mode (intermediate results)"
                android:textColor="?android:attr/textColorPrimary"
                android:visibility="gone" />

            <Button
                android:id="@+id/speechRunButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Run"
                android:visibility="gone" />

            <Button
                android:id="@+id/micRecordButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Record"
                android:visibility="gone" />

            <TextView
                android:id="@+id/waveformInfoTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:text=""
                android:textColor="#FFFF4444"
                android:textSize="14sp"
                android:visibility="gone" />

            <jp.axinc.ailia_kotlin.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/classificationResultTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Classification Result: --"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/transcriptTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/panel_border"
                android:padding="8dp"
                android:fontFamily="monospace"
                android:text=""
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tokenizerInputLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Input Sentence:"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <EditText
                android:id="@+id/tokenizerInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Enter sentence to classify..."
                android:maxLines="4"
                android:minLines="2"
                android:text="今日、新しいiPhoneが発売されました"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tokenizerOutputLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Zero-Shot Classification:"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tokenizerOutputTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="monospace"
                android:text="Result: --"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/trackingResultTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Tracking Results: --"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/multimodalImageView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <EditText
                android:id="@+id/voiceInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Text to speak..."
                android:maxLines="3"
                android:minLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/voiceStatusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Status: Ready"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Generateボタンとバックエンド選択を同じ高さで横並びにする -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/voiceGenerateButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Generate"
                    android:visibility="gone" />

                <Spinner
                    android:id="@+id/voiceEnvSpinner"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/voiceResultTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text=""
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:visibility="gone" />

            <jp.axinc.ailia_kotlin.WaveformView
                android:id="@+id/voiceWaveformView"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <!-- 生成後に表示される小さなリプレイボタン -->
            <Button
                android:id="@+id/voiceReplayButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"
                android:text="Replay"
                android:visibility="gone" />

            <TextView
                android:id="@+id/llmInputLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Input Text:"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <EditText
                android:id="@+id/llmInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Enter your message..."
                android:maxLines="4"
                android:minLines="2"
                android:text="Hello!"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <Button
                android:id="@+id/llmSendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="8dp"
                android:text="Send"
                android:visibility="gone" />

            <TextView
                android:id="@+id/llmStatusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Status: Ready"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/llmOutputLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Chat:"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llmChatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <!-- コンテンツ(画像/結果)の下端にProcessing Timeを配置するためのバリア -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/contentBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="cameraPreviewView,imageView,resultScrollView" />

    <TextView
        android:id="@+id/processingTimeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="Processing Time: -- ms"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/contentBottomBarrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
